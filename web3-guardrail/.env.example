# =========================================================================
# WEB3 TESTNET ENVIRONMENT CONFIGURATION (STAGING ONLY)
# Never place Mainnet keys or real money in this file!
# =========================================================================

# 1. Testnet Burner Private Key (Obtained from a dedicated test wallet like MetaMask)
# Fund this wallet using FREE faucets:
# - Polygon Amoy Faucet: https://faucet.polygon.technology/
# - Avalanche Fuji Faucet: https://faucet.avax.network/
TESTNET_PRIVATE_KEY=0x_YOUR_BURNER_TESTNET_PRIVATE_KEY_HERE

# 2. Free Testnet RPC Endpoints (Can use public or Alchemy/Infura testnet endpoints)
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
AVALANCHE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc

# 3. Target Environment & Chain ID (Guardrail checks this)
# Allowed Chain IDs: 80002 (Amoy), 43113 (Fuji), 31337 (Local Hardhat)
CHAIN_ID=80002
ENVIRONMENT=staging
